<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MoneyTrackerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MoneyTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dedicated Settings Activity for native Android Cross-Activity Predictive Back -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dedicated Add Wallet Activity for native Android Cross-Activity Predictive Back -->
        <activity
            android:name=".AddWalletActivity"
            android:exported="false"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dedicated Transfer Wallet Activity for native Android Cross-Activity Predictive Back -->
        <activity
            android:name=".TransferWalletActivity"
            android:exported="false"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dedicated Add/Edit Transaction Activity for native Android Cross-Activity Predictive Back -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dedicated Receipt Camera Activity (Foto Struk AI OCR) -->
        <activity
            android:name=".ReceiptCameraActivity"
            android:exported="false"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dedicated Notification Activity for native Android Cross-Activity Predictive Back -->
        <activity
            android:name=".NotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.MoneyTracker"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
